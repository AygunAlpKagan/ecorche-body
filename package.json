{
  "name": "ecorche-body",
  "version": "0.3.1",
  "description": "Parametric 2D/3D human anatomy figure for fitness apps. Real muscle-mapped GLB, primary/secondary highlights from gender, height, weight and age.",
  "type": "module",
  "main": "./dist/ecorche-body.js",
  "module": "./dist/ecorche-body.js",
  "exports": {
    ".": {
      "import": "./dist/ecorche-body.js"
    },
    "./style.css": "./dist/ecorche-body.css",
    "./models/*": "./models/*"
  },
  "files": [
    "dist",
    "models",
    "docs",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "anatomy",
    "muscles",
    "fitness",
    "3d",
    "ecorche",
    "react",
    "body",
    "gltf"
  ],
  "license": "MIT AND CC-BY-SA-4.0",
  "author": "Aygun Alp Kagan",
  "repository": {
    "type": "git",
    "url": "https://github.com/AygunAlpKagan/ecorche-body.git"
  },
  "homepage": "https://www.npmjs.com/package/ecorche-body",
  "bugs": {
    "url": "https://github.com/AygunAlpKagan/ecorche-body/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.170.0",
    "vite": "^7.1.7"
  }
}
